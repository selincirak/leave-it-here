# Copy to .env for local development. .env is git-ignored.

# 'gemini-direct' = call Gemini straight from the app (DEV ONLY).
# 'backend'       = call our Edge Function / proxy (required for any release build).
EXPO_PUBLIC_AI_MODE=gemini-direct

# Dev-only key. Never commit. Never use in a release build.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# Used when EXPO_PUBLIC_AI_MODE=backend
EXPO_PUBLIC_AI_BACKEND_URL=
